rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isMember(tid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/tenants/$(tid)/usuarios/$(request.auth.uid));
    }

    function memberData(tid) {
      return get(/databases/$(database)/documents/tenants/$(tid)/usuarios/$(request.auth.uid)).data;
    }

    function myRol(tid) {
      return memberData(tid).rol;
    }

    function isAdmin(tid) {
      return isMember(tid) && myRol(tid) == 'admin';
    }

    function isCobrador(tid) {
      return isMember(tid) && myRol(tid) == 'cobrador';
    }

    function isVisitante(tid) {
      return isMember(tid) && myRol(tid) == 'visitante';
    }

    function isCliente(tid) {
      return isMember(tid) && myRol(tid) == 'cliente';
    }

    function canWrite(tid) {
      return isAdmin(tid) || isCobrador(tid);
    }

    function myRutaId(tid) {
      return memberData(tid).rutaId;
    }

    function myClienteId(tid) {
      return memberData(tid).clienteId;
    }

    function inviteValid(tid, token) {
      return signedIn() && token != null && token is string && token.size() > 10 &&
        exists(/databases/$(database)/documents/tenants/$(tid)/invitaciones/$(token));
    }

    // Roles validos
    // admin     — dueño del tenant, acceso total
    // cobrador  — miembro del equipo, acceso a su ruta
    // visitante — solo lectura, ve todo pero no puede modificar nada
    // cliente   — ve solo sus propios prestamos y cuotas

    // ── Perfil del usuario ───────────────────────────────────────────────

    match /users/{uid} {
      allow read:   if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['tenantId', 'rol', 'email', 'creadoEn'])
                    && request.resource.data.rol in ['admin', 'cobrador', 'visitante', 'cliente'];
      allow update: if signedIn() && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']);
      allow delete: if false;
    }

    // ── Rutas: admin CRUD, resto lectura ─────────────────────────────────

    match /tenants/{tid}/rutas/{doc} {
      allow read:  if isMember(tid);
      allow write: if isAdmin(tid);
    }

    // ── Clientes: admin todo, cobrador su ruta, cliente solo su doc ──────

    match /tenants/{tid}/clientes/{doc} {
      allow read: if isAdmin(tid) || isVisitante(tid)
                  || (isCobrador(tid) && resource.data.rutaId == myRutaId(tid))
                  || (isCliente(tid) && doc == myClienteId(tid));
      allow create: if isAdmin(tid)
                    || (isCobrador(tid) && request.resource.data.rutaId == myRutaId(tid));
      allow update: if isAdmin(tid)
                    || (isCobrador(tid) && resource.data.rutaId == myRutaId(tid)
                        && request.resource.data.rutaId == myRutaId(tid));
      allow delete: if isAdmin(tid);
    }

    // ── Prestamos ────────────────────────────────────────────────────────

    match /tenants/{tid}/prestamos/{doc} {
      allow read:           if isMember(tid);
      allow create, update: if canWrite(tid);
      allow delete:         if isAdmin(tid);
    }

    // ── Movimientos: inmutables, crear con validacion, solo admin borra ──

    match /tenants/{tid}/movimientos/{doc} {
      allow read:   if isMember(tid);
      allow create: if canWrite(tid)
                    && request.resource.data.keys().hasAll(['prestamoId','clienteId','cuotaNro','monto','tipo','fecha','creadoEn'])
                    && request.resource.data.monto > 0
                    && request.resource.data.tipo in ['cuota', 'pago-monto'];
      allow update: if false;
      allow delete: if isAdmin(tid);
    }

    // ── Membresia ────────────────────────────────────────────────────────

    match /tenants/{tid}/usuarios/{uid} {
      allow read: if isMember(tid);
      allow create: if (
                      signedIn() && request.auth.uid == uid && (
                        (tid == request.auth.uid && request.resource.data.rol == 'admin')
                        || inviteValid(tid, request.resource.data.inviteToken)
                      )
                    ) || isAdmin(tid);
      allow update: if isAdmin(tid);
      allow delete: if isAdmin(tid) && uid != request.auth.uid;
    }

    // ── Invitaciones ─────────────────────────────────────────────────────

    match /tenants/{tid}/invitaciones/{token} {
      allow read:   if isMember(tid) || inviteValid(tid, token);
      allow create: if isAdmin(tid)
                    && request.resource.data.keys().hasAll(['email', 'rol', 'rutaId', 'creadoEn'])
                    && request.resource.data.rol in ['cobrador', 'visitante', 'cliente'];
      allow update: if isAdmin(tid);
      allow delete: if isAdmin(tid) || (signedIn() && inviteValid(tid, token));
    }

    // ── Notas de cliente ─────────────────────────────────────────────────

    match /tenants/{tid}/notas/{doc} {
      allow read:   if isMember(tid);
      allow create: if canWrite(tid);
      allow update: if canWrite(tid);
      allow delete: if isAdmin(tid);
    }
  }
}
