rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regla simple: cualquier usuario autenticado puede leer y escribir.
    // La lógica de roles se maneja en el frontend.
    // Movimientos no se pueden editar (solo crear y borrar).

    match /config/{doc} {
      allow read, write: if request.auth != null;
      allow delete:      if false;
    }

    match /usuarios/{uid} {
      allow read, write: if request.auth != null;
    }

    match /rutas/{doc} {
      allow read, write: if request.auth != null;
    }

    match /clientes/{doc} {
      allow read, write: if request.auth != null;
    }

    match /prestamos/{doc} {
      allow read, write: if request.auth != null;
    }

    match /movimientos/{doc} {
      allow read, create, delete: if request.auth != null;
      allow update: if false;
    }

    match /notas/{doc} {
      allow read, write: if request.auth != null;
    }

    match /gastos/{doc} {
      allow read, write: if request.auth != null;
    }

    match /invitaciones/{token} {
      allow read, write: if request.auth != null;
    }
  }
}
